bot = commands.Bot(command_prefix="!", intents=intents)
tree = bot.tree

# 🕐 Cooldown (giây)
COOLDOWNS = {
    "resethwid": 86400,  # 24h
    "redeem": 600,       # 10 phút
    "getscript": 5       # 5 giây
}

# ✅ Role được phép dùng từng lệnh
COMMAND_ROLES = {
    "resethwid": ["Buyer", "Owner"],
    "redeem": ["Member", "Owner"],
    "getscript": ["Buyer", "Owner"],
    "createkey": ["Owner"],           
    "deletekey": ["Owner"]            
}

# 🧠 Bộ nhớ lưu cooldown
cooldown_cache = {}

# 🔎 Check role động
def is_allowed(interaction: discord.Interaction, command: str):
    allowed_roles = COMMAND_ROLES.get(command, [])
    return any(role.name in allowed_roles for role in getattr(interaction.user, 'roles', []))

# 🔁 Check cooldown
def is_on_cooldown(user_id: int, command: str):
    now = time.time()
    last_used = cooldown_cache.get((user_id, command), 0)
    duration = COOLDOWNS.get(command, 0)
    return now - last_used < duration

def get_cooldown_remaining(user_id: int, command: str):
    now = time.time()
    last_used = cooldown_cache.get((user_id, command), 0)
    duration = COOLDOWNS.get(command, 0)
    return int(duration - (now - last_used))

# 🔁 Sync khi bot online
@bot.event
async def on_ready():
    await tree.sync(guild=discord.Object(id=GUILD_ID))
    print(f"✅ Logged in as {bot.user} | Synced slash commands.")

# 🛠 /createkey
@tree.command(name="createkey", description="Tạo key mới", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(key="Key bạn muốn tạo")
async def create_key(interaction: discord.Interaction, key: str):
    await interaction.response.defer(thinking=True, ephemeral=True)
    if not is_allowed(interaction, "createkey"):  # mặc định chỉ Owner, nếu muốn thêm thì sửa COMMAND_ROLES
        await interaction.followup.send("❌ Bạn không có quyền dùng lệnh này.")
        return
    res = requests.post(GS_API_URL, data={"action": "createKey", "key": key})
    await interaction.followup.send(f"```lua\n{res.text}\n```")

