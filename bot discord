# 🔓 /redeem
@tree.command(name="redeem", description="Redeem key của bạn", guild=discord.Object(id=GUILD_ID))
@app_commands.describe(key="Key bạn có")
async def redeem_key(interaction: discord.Interaction, key: str):
    await interaction.response.defer(thinking=True, ephemeral=True)
    user_id = interaction.user.id
    command = "redeem"
    
    if not is_allowed(interaction, command):
        await interaction.followup.send("❌ Bạn không có quyền dùng lệnh này.")
        return

    if is_on_cooldown(user_id, command):
        remain = get_cooldown_remaining(user_id, command)
        await interaction.followup.send(f"⏳ Bạn cần chờ {remain} giây để dùng lại lệnh này.")
        return

    try:
        res = requests.post(GS_API_URL, data={"action": "redeemKey", "key": key, "discordID": str(user_id)})
        cooldown_cache[(user_id, command)] = time.time()
        await interaction.followup.send(f"```lua\n{res.text}\n```")
    except Exception as e:
        await interaction.followup.send(f"❌ Lỗi kết nối API: {e}")

