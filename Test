-- Setup khi nhân vật spawn
local function setupCharacter(character)
    characterReady = false
    movedManually = false
    teleportLocked = false
    lockTimerStarted = false
    teleportLockPriority = 0
    currentHumanoid = character:WaitForChild("Humanoid", 5)
    local hrp = character:WaitForChild("HumanoidRootPart", 5)
    if not hrp or not currentHumanoid then return end

    task.spawn(function()
        local maxWait = 5
        local elapsed = 0
        while elapsed < maxWait do
            updateCurrentFruit()
            if currentFruit and hrp:IsDescendantOf(game) then
                characterReady = true
                break
            end
            elapsed += 0.2
            task.wait(0.2)
        end
    end)
end

